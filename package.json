  "keywords": [
    "surea11y",
    "binding",
    "internal"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/binding-base.git"
  },
  "homepage": "https://github.com/SureA11y/binding-base#readme",
  "bugs": {
    "url": "https://github.com/SureA11y/binding-base/issues"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@surea11y/core": "^1.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
